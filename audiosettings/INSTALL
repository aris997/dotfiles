# you need alsa-utils
# add these lines to i3 config file
bindsym XF86AudioRaiseVolume exec --no-startup-id amixer set Master 5%+ && amixer set Master unmute && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id amixer set Master 5%- && amixer set Master unmute && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id amixer set Master toggle && $refresh_i3status



